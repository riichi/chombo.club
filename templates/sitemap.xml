{#- Sitemap of every language, rendered once by Zola as /sitemap.xml. Each URL that exists in
    more than one language lists all of them as hreflang alternates (and x-default: the default
    language), matching the <link rel="alternate"> tags in the pages. Static files are not listed. -#}
{%- set tz = config.extra.timezone -%}
{%- set default_lang = config.default_language -%}
{%- set site_langs = [default_lang, ...(config.languages | keys)] | sort -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for l in site_langs %}
{%- set prefix = <lang_prefix lang={l} default={default_lang} /> -%}
{%- set root = get_section(path="_index.md", lang=l) -%}
{%- set posts_section = get_section(path="posts/_index.md", lang=l) -%}
{%- set posts = posts_section.pages | reverse %}
<url>
<loc>{{ root.permalink }}</loc>
{{- <sitemap_alternates alts={root.translations} default={default_lang} /> }}
</url>
{%- for p in posts %}
<url>
<loc>{{ p.permalink }}</loc>
<lastmod>{{ <xmlschema d={p.updated or p.date} tz={tz} /> }}</lastmod>
{{- <sitemap_alternates alts={p.translations} default={default_lang} /> }}
</url>
{%- endfor %}
{%- set pages_section = get_section(path="pages/_index.md", lang=l) -%}
{%- for p in pages_section.pages | sort(attribute="path") %}
{%- if not p.date and p.extra?.sitemap != false %}{#- posts bubble up through the transparent sections -#}
<url>
<loc>{{ p.permalink }}</loc>
{{- <sitemap_alternates alts={p.translations} default={default_lang} /> }}
</url>
{%- endif %}
{%- endfor %}
{#- Category pages. Taxonomy terms have no `translations`; a term's alternates are the same slug in the other languages. -#}
{%- set categories = get_taxonomy(kind="categories", lang=l) -%}
{%- for term in categories.items %}
{%- set_global term_alts = [] -%}
{%- for l2 in site_langs -%}
{%- set l2_categories = get_taxonomy(kind="categories", lang=l2) -%}
{%- if term.name in (l2_categories.items | group_by(attribute="name")) -%}
{%- set_global term_alts = [...term_alts, {"lang": l2, "permalink": config.base_url ~ (<lang_prefix lang={l2} default={default_lang} />) ~ "/categories/" ~ term.slug ~ "/"}] -%}
{%- endif -%}
{%- endfor %}
<url>
<loc>{{ term.permalink }}</loc>
{{- <sitemap_alternates alts={term_alts} default={default_lang} /> }}
</url>
{%- endfor %}
{#- Home pagination: /page/2/ … (pages differ per language, so no alternates). -#}
{%- set per_page = root.paginate_by or 10 -%}
{%- set n_pages = ((posts | length) + per_page - 1) // per_page -%}
{%- for i in range(start=2, end=n_pages + 1) %}
<url>
<loc>{{ config.base_url }}{{ prefix }}/page/{{ i }}/</loc>
</url>
{%- endfor %}
{%- endfor %}
</urlset>
